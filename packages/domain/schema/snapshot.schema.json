    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "part_of",
            "specializes",
            "depends_on",
            "related_to",
            "caused_by",
            "tradeoff_with",
            "addresses",
            "extends",
            "builds_on",
            "introduces_issue",
            "assumes",
            "instance_of",
            "proposes",
            "supports",
            "contradicts",
            "refines",
            "about"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "from",
        "to"
      ]
    },
    "Figure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 1e-06,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 1e-06,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "asset_id",
        "caption",
        "source_name",
        "source_url",
        "source_pdf_sha256",
        "page",
        "crop",
        "extracted_at"
      ]
    },
    "Reading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "novelty": {
          "type": "string"
        },
        "key_idea": {
          "type": "string"
        },
        "validation": {
          "type": "string"
        },
        "discussion": {
          "type": "string"
        },
        "key_figures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_formulas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "captions_ja": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "locator"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "cites": {
          "type": "object",
          "additionalProperties": false,
          "description": "Evidence IDs for each reading field; summary is the paper's one_line_summary.",
          "properties": {
            "summary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "contributions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "novelty": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "key_idea": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "validation": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "discussion": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "key_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Sections needed to understand the paper, each starting with its section number, e.g. \"3.2 Pseudocode: why\"."
        }
      },
      "required": [
        "contributions",
        "novelty",
        "key_idea",
        "validation",
        "discussion",
        "key_figures"
      ]
    },
    "TutorialSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "definition",
            "motivation",
            "methods",
            "summary",
            "challenges",
            "variants",
            "hands_on",
            "further_reading",
            "conclusion"
          ]
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "paper": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "caption_ja": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "A faithful Japanese translation of the paper's caption for this label."
              }
            },
            "required": [
              "paper",
              "label"
            ]
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "title"
            ]
          }
        }
      },
      "required": [
        "role",
        "heading",
        "body",
        "refs",
        "media",
        "links"
      ]
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": [
            "fixture",
            "user",
            "codex"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "Resource"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "survey",
            "tutorial",
            "blog",
            "slides",
            "talk",
            "repository",
            "website",
            "book",
            "course",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 20
        },
        "published": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "paper": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "id",
        "label",
        "provenance",
        "type",
        "kind",
        "title",
        "url",
        "authors",
        "published",
        "language",
        "summary",
        "issues",
        "methods",
        "paper",
        "checked_at"
      ]
    }
  }
}
