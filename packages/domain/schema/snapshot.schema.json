          "minLength": 1
        },
        "papers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "official_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "definition_excerpt": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "provenance",
        "type",
        "aliases",
        "category",
        "meaning",
        "papers",
        "related",
        "definition_excerpt",
        "source_url",
        "locator"
      ]
    },
    "Tutorial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": [
            "fixture",
            "user",
            "codex"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "Tutorial"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TutorialSection"
          }
        },
        "summary": {
          "type": "string",
          "description": "One sentence explaining the field the tutorial covers."
        }
      },
      "required": [
